# Runtime state (crash-recovery dumps, caches). The server writes to
# $CMDCTRL_DATA_DIR which defaults to "./data" — relative to the CWD
# when the server runs — so a dev running `make dev` from server/
# creates server/data/, while /data/ at the repo root covers the
# other common case.
/data/
/server/data/
*.log

# Asset-pack archives (S09 sound bundles, art packs). The unpacked
# individual files belong under client/public/ where they are
# tracked; the zip itself is provenance-only and bloats history.
*.zip

# Scratch deck lists used for manual S19 testing — referenced by
# nothing in the repo; the e2e suites build their decks in code
# (tests-e2e/tests/*deck-fixture.ts).
/test-decks/

# Secrets / env
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.orig

# Editor / IDE state (user-specific, not project config)
.vscode/
.idea/
*.iml

# Claude Code per-project state. `.claude/settings.json` is a
# command-permission allowlist; remove this line (or add
# `!.claude/settings.json`) if you want to share it with collaborators.
.claude/

# Node / Vite (for client/)
node_modules/
dist/
.vite/
.svelte-kit/
.cache/

# Go (for server/)
/server/bin/
*.test
*.out
coverage.txt
coverage.html
