# Caddy site block for the develop preview environment (ADR 0023).
#
# Install:
#   sudo cp deploy/caddy/dev.cmd.labxp.io.caddyfile /etc/caddy/conf.d/
#   # ...or paste the block into /etc/caddy/Caddyfile directly, if
#   # that host has no conf.d and no `import conf.d/*` line.
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# TLS is automatic — Caddy provisions and renews the certificate for
# dev.cmd.labxp.io on its own, so there is no certbot step. The DNS
# record has to exist and resolve to this host first.

dev.cmd.labxp.io {
	encode zstd gzip

	# Every path the Go server owns. One `path` matcher because
	# multiple arguments to a single matcher are OR'ed, whereas
	# repeating the directive would AND them and match nothing.
	#
	# KEEP THIS IN SYNC with client/vite.config.ts. A new top-level
	# route needs an entry in both, and the failure is silent in each:
	# missing here, the browser gets index.html and the JSON parse
	# fails; missing there, the same thing happens under
	# `make client-dev`.
	@api path /ws /config /dev /dev/* /admin/* /games /games/* /cards/* /auth/* /avatars/* /bugreport /bugreport/* /me /logout /healthz
	reverse_proxy @api 127.0.0.1:8081

	# Do NOT add `header_up Host {upstream_hostport}` here. Caddy
	# forwards the original Host by default, and the game server's
	# WebSocket CheckOrigin compares the Origin header's host against
	# the request Host (ws/hub.go:checkOrigin). Rewriting Host to
	# 127.0.0.1:8081 makes every /ws upgrade 403 with "rejected by
	# CheckOrigin" while ordinary HTTP keeps working — which is a
	# confusing way to spend an afternoon. WebSocket upgrades need no
	# other special handling; reverse_proxy passes them through.

	root * /var/www/cmdctrl-client-dev
	# The client is a hash-router SPA, so real requests are all for
	# "/" — but this keeps a hand-typed deep link from 404ing.
	try_files {path} /index.html
	file_server
}
