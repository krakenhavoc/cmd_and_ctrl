{
  "uid": "cmdctrl-overview",
  "title": "cmd_and_ctrl / Overview",
  "description": "The owner's question at a glance: how many games and players there are now, how many accounts exist and how many played recently, games and new users per day, and which build is running (ADR 0123 \u00a79).",
  "tags": [
    "cmd_and_ctrl"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 42,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "weekStart": "",
  "links": [
    {
      "title": "cmd_and_ctrl",
      "type": "dashboards",
      "tags": [
        "cmd_and_ctrl"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Server starts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "hide": false,
        "iconColor": "rgba(255, 152, 48, 1)",
        "expr": "changes(process_start_time_seconds{job=\"cmdctrl-server\", env=\"$env\"}[2m]) > 0",
        "step": "1m",
        "titleFormat": "Server started",
        "textFormat": "{{host}}",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "env",
        "type": "custom",
        "description": "Which environment's host and server to show.",
        "query": "prod,dev",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          },
          {
            "text": "dev",
            "value": "dev",
            "selected": false
          }
        ],
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "skipUrlSync": false
      },
      {
        "name": "site",
        "type": "query",
        "hide": 2,
        "refresh": 2,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(probe_success{job=\"blackbox\", env=\"$env\"}, instance)",
          "refId": "site"
        },
        "regex": "/^(https:\\/\\/[^\\/]+)/",
        "includeAll": false,
        "multi": false,
        "skipUrlSync": true
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Right now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Active games",
      "description": "Tables in play now: state active, not archived. Practice tables are not counted.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(cmdctrl_games{env=\"$env\", state=\"active\", archived=\"false\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
