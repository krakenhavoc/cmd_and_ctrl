    {
      "type": "timeseries",
      "title": "Errors and warnings per minute, by unit",
      "description": "Lines at level warn or error (the level label comes from a JSON line's own level).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (unit, level) (count_over_time({env=\"$env\", level=~\"warn|error\"} [1m]))",
          "queryType": "range",
          "editorMode": "code",
          "legendFormat": "{{unit}} {{level}}"
