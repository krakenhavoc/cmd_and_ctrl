{
  "uid": "cmdctrl-server",
  "title": "cmd_and_ctrl / Server",
  "description": "HTTP rate, latency and errors by route, WebSocket connections, churn and frames, the database, and the Go runtime and process (ADR 0123 \u00a79).",
  "tags": [
    "cmd_and_ctrl"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "1m",
