    {
      "type": "stat",
      "title": "Site up",
      "description": "The blackbox probe of this environment's /healthz, through Cloudflare. Empty for monitoring.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
