# cmd-and-ctrl-dev — the develop-branch preview deployment.
#
# Runs beside cmd-and-ctrl.service on the same VPS, deployed by the
# CD job on every push to `develop`. See docs/environments.md for the
# one-time host provisioning and docs/decisions/0023-develop-environment.md
# for why it looks like this.
#
# Everything is namespaced away from production: its own service user,
# env file, data directory, port, and web root. The two deployments
# share only the box and (read-only) the Scryfall bulk dump.
#
# Install:
#   sudo cp deploy/cmd-and-ctrl-dev.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now cmd-and-ctrl-dev
#
# The env file must exist at /etc/cmd_and_ctrl/dev.env, mode 0640,
# group cmdctrl-dev. CMDCTRL_ENV=dev is rewritten there by every
# develop deploy, so this deployment cannot drift into prod mode.

[Unit]
Description=cmd_and_ctrl game server (develop preview)
After=network-online.target
Wants=network-online.target
# Deliberately NOT ordered against cmd-and-ctrl.service. The dev
# deployment must never be able to delay, block, or trigger a restart
# of production.

[Service]
Type=simple
User=cmdctrl-dev
Group=cmdctrl-dev
EnvironmentFile=/etc/cmd_and_ctrl/dev.env
ExecStart=/opt/cmd_and_ctrl-dev/server/bin/cmd_and_ctrl-server
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Resource ceilings. The whole point of sharing a box with production
# is cost, and the whole risk of sharing a box with production is a
# runaway dev process. MemoryMax is a hard cap: the dev server is
# OOM-killed and restarted rather than pushing prod into swap.
# Tune upward if the card index legitimately needs more.
MemoryMax=768M
MemoryHigh=640M
CPUWeight=50
# Dev loses the scheduler tie-break against prod (default 100).

# State lives at /var/lib/cmd_and_ctrl-dev, created and chowned by
# systemd on first start. Point CMDCTRL_DATA_DIR at it in dev.env.
StateDirectory=cmd_and_ctrl-dev
StateDirectoryMode=0750

# Hardening — mirrors cmd-and-ctrl-bot.service, with the writable
# state directory added back (the game server persists replays,
# cached card images, avatars, and bug-report artifacts).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
# Production's data directory is NOT listed here, and cmdctrl-dev is
# not in the cmdctrl group: the dev process cannot read prod replays
# or write anything prod reads. The Scryfall dump is shared read-only
# via a symlink (docs/environments.md) — reads are unaffected by
# ProtectSystem=strict.

[Install]
WantedBy=multi-user.target
