# cmd_and_ctrl-bot — S12.5 Discord slash-command bot.
#
# Runs next to cmd-and-ctrl.service on the same VPS. Dials out
# to discord.com/api/gateway; needs no inbound ports. Calls back
# into the game server over loopback for admin-scoped actions.
#
# Installed on production only, by CD on every main deploy ("Install
# bot systemd unit" in .github/workflows/ci-cd.yml), which also writes
# /etc/cmd_and_ctrl/bot.env (root:cmdctrl-bot 0640). CD never enables
# the unit; that and creating the cmdctrl-bot user are operator steps
# in deploy/README.md, needed again after every rebuild of production
# until the HomeLab template creates the user. See
# docs/decisions/0004-discord-identity.md for the rationale for the
# separate env file.

[Unit]
Description=cmd_and_ctrl Discord bot
After=network-online.target cmd-and-ctrl.service
Wants=network-online.target
# Start after the game server so the first loopback call has a
# live target. The game server is not a hard dependency — if it
# goes down, the bot stays connected to Discord and surfaces
# "server unreachable" on each invocation until the server is
# back.

# Bound the restart loop (#598): with Restart=on-failure and no
# StartLimit*, a crash on every start (e.g. 203/EXEC from a bad
# binary path) restarts forever with nothing to alarm on — the
# cmd-and-ctrl.service incident this issue is named for ran ~540k
# times over a month before anyone noticed. 10 starts within 10
# minutes flips the unit to `failed` and stops it there, which IS a
# state something can watch for (systemctl is-failed, the monitoring
# agent's systemd collector and its UnitFailed alert, ADR 0123 §7). At
# RestartSec=5 a crash loop gets there in under a minute, while a
# deploy's single restart, or a few by hand, stays far below it. The
# same numbers as cmd-and-ctrl.service (HomeLab#119). StartLimitIntervalSec
# / StartLimitBurst belong on [Unit], not [Service]: they bound the
# unit's start attempts as such, independent of which Restart= policy
# triggered them (systemd.unit(5)).
#
# A unit that hit the limit refuses even a manual start until the
# interval has passed, so CD runs `systemctl reset-failed` right before
# its restart: a fix deployed minutes after a crash loop still starts.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
User=cmdctrl-bot
Group=cmdctrl-bot
EnvironmentFile=/etc/cmd_and_ctrl/bot.env
ExecStart=/opt/cmd_and_ctrl/bot/bin/cmd_and_ctrl-bot
Restart=on-failure
RestartSec=5
# Stream logs to journald so `journalctl -u cmd-and-ctrl-bot -f`
# Just Works.
StandardOutput=journal
StandardError=journal

# Hardening. The bot only needs outbound HTTPS + a read on its
# env file; everything else can be locked down.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
